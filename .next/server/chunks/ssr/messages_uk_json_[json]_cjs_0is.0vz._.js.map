neMobileRequired":"Введіть мобільний телефон","streetAddressRequired":"Введіть адресу","cityRequired":"Введіть місто","stateRequired":"Оберіть штат","postCodeRequired":"Введіть ZIP-код","birthDateRequired":"Введіть дату народження","birthDateInvalid":"Використовуйте формат ММ/ДД/РРРР"},"thankYou":{"title":"Перевірте email — ми надіслали посилання на ваш клієнтський кабінет.","message":"У кабінеті ви зможете завантажити кредитні звіти, переглянути план і відстежувати всі оновлення.","backToHome":"На головну"},"faq":{"title":"FAQ","q1":"Як ефективно використовувати кредит?","a1":"У більшості штатів страховики можуть враховувати вашу кредитну історію при розрахунку страхових внесків. Підтримання сильного кредитного профілю допомагає отримати найконкурентніші ставки.","q2":"Що таке кредитний рейтинг?","a2":"Кредитний рейтинг — числове відображення вашої кредитоспроможності на основі фінансової історії. Страховики можуть використовувати його як один з факторів при визначенні страхових внесків.","q3":"Як покращити кредитний рейтинг?","a3":"Покращення кредитного рейтингу включає своєчасні платежі, скорочення заборгованості та відмову від непотрібних кредитних запитів. Вищий рейтинг може позитивно впливати на страхові ставки.","q4":"Як створити кредитну історію?","a4":"Створення кредитної історії зазвичай починається з відкриття захищеної кредитної картки або додавання як авторизованого користувача. Послідовне відповідальне використання кредиту формує надійну фінансову історію."},"footer":{"services":"Послуги","price":"Ціни","faq":"FAQ","contact":"Контакти","privacy":"Політика конфіденційності","terms":"Умови використання","logoAlt":"Логотип Profit Craft"},"legal":{"privacyTitle":"Політика конфіденційності","termsTitle":"Умови використання","privacyMetaDescription":"Як ProfitCraft збирає, використовує та захищає інформацію, надіслану через наш сайт.","termsMetaDescription":"Умови використання сайту та послуг ProfitCraft.","backToHome":"На головну"},"messenger":{"toggleLabel":"Відкрити варіанти зв'язку","messenger":"Messenger","whatsapp":"WhatsApp","telegram":"Telegram"},"locale":{"en":"English","ru":"Русский","uk":"Українська"}}